# ============================================================
# OS / desktop junk
# ============================================================
.DS_Store
Thumbs.db


# ============================================================
# Editor / temporary files
# ============================================================
*.swp
*.swo
*.tmp
*~
*.bak
*.copy


# ============================================================
# Logs
# ============================================================
*.log
autosync.log


# ============================================================
# Secrets / credentials
# NEVER commit these to the dotfiles repository
# ============================================================
secrets/
secrets_plain/
secret-backup*/
*.tar.gz.gpg
*.gpg
*.nmconnection

# Common private-key / certificate formats
*.key
*.p12
*.pfx

# Environment files that may contain credentials
.env
.env.*
!.env.example


# ============================================================
# Nix / Home Manager build output
# ============================================================
result
result-*
.direnv/


# ============================================================
# Large/generated disk images
# ============================================================
*.iso
*.img


# ============================================================
# Package/cache directories
# ============================================================
brew-cache/


# ============================================================
# Temporary migration / restore files
# ============================================================
*.pre-home-manager
*.hm-before-cleanup

# ============================================================
# Restic credentials
# ============================================================
.config/restic/
restic-password*

# Transactional snapshot workspaces and local previous generation
.system-backup-capture-*/
.system-backup.previous/
.system-backup.lock
__pycache__/

# ============================================================
# Private local data (keep recovery copies on the backup drive)
# ============================================================
# Captures can contain usernames, device IDs, desktop history and network rules.
/system-backup/
/personal/
/private/

# SSH/GnuPG keys, wallets and service credentials
.ssh/
.gnupg/
.aws/
.azure/
.kube/
.local/share/kwalletd/
*.kwl
*.wallet
*.kdbx
*.pem
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
service-account*.json
.netrc
.authinfo
.authinfo.gpg
.npmrc
.pypirc

# Local overrides; commit sanitized *.example files instead.
*.local.json
*.local.toml
*.local.yaml
*.local.yml
