#!/usr/bin/env bash
# Guided first-time setup for a new Garuda/Arch machine: personalise
# machine.json, install the system applications, Nix and the Home Manager
# configuration, and prepare Restic when an external drive is attached.
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
machine="$repo/home-manager/machine.json"
zed_settings="$repo/configs/zed/settings.json"
dry_run=false

case "${1:-}" in
  '') ;;
  --dry-run) dry_run=true ;;
  --help | -h)
    echo 'Usage: scripts/setup [--dry-run]'
    echo 'Asks for your name, Git identity and backup drive, then installs everything.'
    echo '--dry-run asks the same questions and prints what would change.'
    exit 0
    ;;
  *)
    echo "Unknown argument: $1" >&2
    exit 1
    ;;
esac

die() {
  echo "Error: $*" >&2
  exit 1
}

run() {
  if "$dry_run"; then
    printf 'Would run:'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

ask() {
  local prompt=$1 default=${2:-} answer
  while true; do
    if [[ -n "$default" ]]; then
      read -r -p "$prompt [$default]: " answer
    else
      read -r -p "$prompt: " answer
    fi
    answer=${answer:-$default}
    [[ -n "$answer" ]] && break
    echo 'A value is required.' >&2
  done
  printf '%s\n' "$answer"
}

# A value from machine.json, but only once it describes this account, so a
# rerun offers your own answers and a fresh clone does not offer the author's.
saved() {
  python3 -I - "$machine" "$USER" "$1" <<'PY'
import json, sys
path, user, key = sys.argv[1:]
try:
    data = json.load(open(path))
except (OSError, ValueError):
    data = {}
if data.get('username') == user:
    print(data.get(key, ''))
PY
}

((EUID != 0)) || die 'run as your normal user, without sudo.'
[[ $(uname -m) == x86_64 ]] || die 'this configuration targets x86_64.'
command -v pacman >/dev/null || die 'pacman was not found; this setup targets Garuda and other Arch-family systems.'
git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die 'clone this repository with Git; a downloaded ZIP cannot be built.'
[[ -t 0 ]] || die 'run this in a terminal; it asks questions.'
command -v python3 >/dev/null || run sudo pacman -S --needed python

echo '==> About you'
default_name=$(saved displayName)
display_name=$(ask 'Name for the terminal greeting' "${default_name:-${USER^}}")
default_git_name=$(saved gitName)
git_name=$(ask 'Git author name' "${default_git_name:-$(git config --global user.name 2>/dev/null || true)}")
default_git_email=$(saved gitEmail)
git_email=$(ask 'Git author email' "${default_git_email:-$(git config --global user.email 2>/dev/null || true)}")

echo
echo '==> Terminal and tools'
echo '  Nix and the Home Manager configuration: Fish, Starship, Fastfetch and Neovim'
echo '  from this repository, the Nerd Fonts, and the backup and restore commands'
echo '  (backup-personal, hm-rebuild, restore-sddm and the others). Without them the'
echo '  system applications, login screen, boot menu, boot splash and firewall are'
echo '  still set up; the terminal can come from Myfish or the toolbox later.'
read -r -p 'Install Nix and Home Manager too? [Y/n] ' answer
home_manager=true
[[ "$answer" == [nN]* ]] && home_manager=false

echo
echo '==> Backup drive'
backup=false
wallet=$(saved wallet)
wallet=${wallet:-kdewallet}
wallet_folder=$(saved walletFolder)
wallet_folder=${wallet_folder:-Restic}
backup_mount=$(saved backupMount)
drives=()
for directory in "/run/media/$USER"/*/; do
  [[ -d "$directory" ]] && mountpoint -q "${directory%/}" && drives+=("${directory%/}")
done
if ! "$home_manager"; then
  backup_mount=${backup_mount:-/run/media/$USER/Backup}
  echo 'The backup commands come with Home Manager, so Restic setup is skipped.'
elif ((${#drives[@]} == 0)); then
  backup_mount=${backup_mount:-/run/media/$USER/Backup}
  echo 'No external drive is mounted, so Restic setup is skipped.'
  echo 'Attach and unlock your backup drive, then run this script again.'
else
  # A saved drive that is not attached right now stays configured unless another is picked.
  default_choice=1
  [[ -n "$backup_mount" ]] && default_choice=0
  for i in "${!drives[@]}"; do
    [[ "${drives[$i]}" == "$backup_mount" ]] && default_choice=$((i + 1))
    printf '  %d) %s (%s free)\n' "$((i + 1))" "${drives[$i]}" "$(df -h --output=avail "${drives[$i]}" | tail -n 1 | tr -d ' ')"
  done
  echo '  0) Skip backup setup for now'
  while true; do
    choice=$(ask 'Drive to keep backups on' "$default_choice")
    [[ "$choice" =~ ^[0-9]+$ ]] && ((choice <= ${#drives[@]})) && break
    echo 'Choose one of the listed numbers.' >&2
  done
  if ((choice == 0)); then
    backup_mount=${backup_mount:-${drives[0]}}
  else
    backup=true
    backup_mount=${drives[$((choice - 1))]}
  fi
fi
restic_repository="$backup_mount/restic"
secrets_directory="$backup_mount/secrets"
wallet_entry=$(saved walletEntry)
# Each drive keeps its own KWallet entry, named after it.
if "$backup" || [[ -z "$wallet_entry" ]]; then
  wallet_entry=$(basename -- "$backup_mount")
fi

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
login_shell=$(getent passwd "$USER" | cut -d: -f7)
shell_changed=false
login_theme_installed=false
display_manager_switched=false
boot_theme_installed=false
boot_splash_installed=false
# The unit behind the login screen, such as sddm.service or plasmalogin.service.
display_manager=$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)")

echo
echo '==> Everyday apps'
echo '  Brave Origin, LibreOffice, GitHub CLI, bottom, yt-dlp, System Monitor and Stacer,'
echo '  plus Proton Pass, Proton Mail, RustDesk and Mission Center from Flathub.'
read -r -p 'Install these too? [Y/n] ' answer
apps=true
[[ "$answer" == [nN]* ]] && apps=false

login_theme=false
if [[ -x /usr/bin/sddm ]]; then
  echo
  echo '==> Login screen'
  echo '  The SilentSDDM theme with the presets and backgrounds in sddm/. It also turns'
  echo '  Num Lock on at the login screen and automatic login off.'
  if [[ "$display_manager" != sddm.service ]]; then
    # Only SDDM shows the theme; Garuda now enables Plasma Login Manager instead.
    if [[ -n "$display_manager" ]]; then
      echo "  Your login screen is run by $display_manager, which ignores SDDM themes, so"
      echo '  this also switches the login screen to SDDM at the next reboot.'
    else
      echo '  No login screen service is enabled, so this also enables SDDM.'
    fi
  fi
  read -r -p 'Install it too? [Y/n] ' answer
  login_theme=true
  [[ "$answer" == [nN]* ]] && login_theme=false
fi

boot_theme=false
# A Limine machine, such as a CachyOS install, has /etc/default/limine for its
# entry tool. It is checked first because the grub package leaves
# /etc/default/grub behind even where GRUB is not the boot loader.
boot_loader=''
if [[ -f /etc/default/limine ]]; then
  boot_loader=limine
elif [[ -f /etc/default/grub ]]; then
  boot_loader=grub
elif command -v limine >/dev/null; then
  boot_loader=limine
fi
boot_look=''
if [[ -n "$boot_loader" ]]; then
  echo
  echo '==> Boot'
  if [[ "$boot_loader" == grub ]]; then
    echo '  The GRUB settings in grub/: a boot menu look, a two-second menu and the kernel'
    echo '  parameter that turns AppArmor on, with the AppArmor service enabled.'
  else
    echo '  The Limine boot menu look in limine/: a wallpaper and colours and a two-second'
    echo '  menu, plus the kernel parameter that turns AppArmor on, with the AppArmor'
    echo '  service enabled.'
  fi
  echo '  They apply at the next reboot.'
  read -r -p 'Set these up too? [Y/n] ' answer
  boot_theme=true
  [[ "$answer" == [nN]* ]] && boot_theme=false
  if "$boot_theme"; then
    # The look is remembered per machine, so restore-grub and restore-limine keep it.
    boot_look_file="$config_home/dotfiles/boot-theme"
    if [[ -s "$boot_look_file" ]]; then
      boot_look=$(head -n 1 "$boot_look_file" | tr -d '[:space:]')
    else
      boot_look=$(head -n 1 "$repo/$boot_loader/theme" | tr -d '[:space:]')
    fi
    default_choice=1
    [[ "$boot_look" == cachyos ]] && default_choice=2
    echo '  Looks: 1) Garuda dr460nized  2) CachyOS'
    read -r -p "Which look? [$default_choice] " answer
    case "${answer:-$default_choice}" in
      1) boot_look=garuda ;;
      2) boot_look=cachyos ;;
      *) echo "Keeping $boot_look." ;;
    esac
  fi
fi

boot_splash=false
if pacman -Qq plymouth >/dev/null 2>&1; then
  echo
  echo '==> Boot splash'
  echo "  The Plymouth theme named in plymouth/theme ($(head -n 1 "$repo/plymouth/theme")), shown"
  echo '  while the system starts, rebuilt into the boot images, plus the Boot Splash Screen'
  echo '  page in System Settings for picking another.'
  read -r -p 'Set it up too? [Y/n] ' answer
  boot_splash=true
  [[ "$answer" == [nN]* ]] && boot_splash=false
fi

echo
echo '==> Firewall'
echo '  UFW blocking unsolicited incoming connections and allowing outgoing ones, with'
echo '  logging on low, plus the gufw window to manage it. If KDE Connect is installed,'
echo '  its ports are allowed from the local network only.'
read -r -p 'Turn it on too? [Y/n] ' answer
firewall=true
[[ "$answer" == [nN]* ]] && firewall=false

echo
echo '==> Plan'
echo "  Greeting name:  $display_name"
echo "  Git identity:   $git_name <$git_email>"
echo "  Account:        $USER ($HOME)"
echo "  Dotfiles:       $repo"
if "$backup"; then
  echo "  Backups:        $restic_repository (KWallet: $wallet / $wallet_folder / $wallet_entry)"
else
  echo '  Backups:        not set up in this run'
fi
if "$home_manager"; then
  echo '  Installs:       Zed, Ghostty, Konsole, KWallet, GnuPG, Nix and the Home Manager configuration'
  echo '  Languages:      Rust, Go, Python and Node.js, which the Neovim tools are built with'
  echo '  Shell helpers:  the Pacman tools, archive tools and notifier that the Fish commands call'
else
  echo '  Installs:       Zed, Ghostty, Konsole, KWallet and GnuPG; no Nix or Home Manager'
fi
if "$apps"; then
  echo '  Everyday apps:  the browser, office, monitoring, Proton and remote desktop apps listed above'
fi
if "$login_theme"; then
  echo '  Login screen:   SilentSDDM with the presets in sddm/'
  [[ "$display_manager" == sddm.service ]] || echo '                  with SDDM enabled as the login screen'
fi
if [[ "$boot_loader" == grub ]] && "$boot_theme"; then
  echo "  Boot:           the GRUB settings in grub/ with the $boot_look look, AppArmor on at the next reboot"
elif "$boot_theme"; then
  echo "  Boot:           the Limine boot menu in limine/ with the $boot_look look, AppArmor on at the next reboot"
fi
if "$boot_splash"; then
  echo '  Boot splash:    the Plymouth theme in plymouth/theme and the Boot Splash Screen settings page'
fi
if "$firewall"; then
  echo '  Firewall:       UFW on, incoming blocked, outgoing allowed'
fi
echo '  Terminal:       Ghostty becomes the default, with the dotfiles preset if it has no config yet'
[[ "$login_shell" == */fish ]] || echo "  Login shell:    Fish, replacing $login_shell"
echo
read -r -p 'Type APPLY to continue: ' confirmation
[[ "$confirmation" == APPLY ]] || die 'cancelled; nothing was changed.'

echo
echo '==> Machine settings'
settings=$(
  DISPLAY_NAME=$display_name GIT_NAME=$git_name GIT_EMAIL=$git_email REPO=$repo \
    BACKUP_MOUNT=$backup_mount RESTIC_REPOSITORY=$restic_repository \
    WALLET=$wallet WALLET_FOLDER=$wallet_folder WALLET_ENTRY=$wallet_entry python3 -I - <<'PY'
import json, os
env = os.environ
print(json.dumps({
    'username': env['USER'],
    'homeDirectory': env['HOME'],
    'displayName': env['DISPLAY_NAME'],
    'gitName': env['GIT_NAME'],
    'gitEmail': env['GIT_EMAIL'],
    'system': 'x86_64-linux',
    'dotfilesDirectory': env['REPO'],
    'backupMount': env['BACKUP_MOUNT'],
    'resticRepository': env['RESTIC_REPOSITORY'],
    'wallet': env['WALLET'],
    'walletFolder': env['WALLET_FOLDER'],
    'walletEntry': env['WALLET_ENTRY'],
}, indent=2, ensure_ascii=False))
PY
)
if "$dry_run"; then
  echo "Would write $machine:"
  printf '%s\n' "$settings"
  echo "Would point the Nix profile paths in $zed_settings at $HOME."
else
  printf '%s\n' "$settings" >"$machine"
  # Zed keeps this file writable and takes absolute paths to the Nix tools.
  python3 -I - "$zed_settings" "$HOME" <<'PY'
import re, sys
from pathlib import Path
path, home = Path(sys.argv[1]), sys.argv[2]
text = path.read_text()
updated = re.sub(r'"/home/[^/"]+/\.nix-profile/', lambda _: f'"{home}/.nix-profile/', text)
if updated != text:
    path.write_text(updated)
PY
  echo "Wrote $machine"
fi

echo
echo '==> System applications'
packages=(git zed ghostty konsole kwallet qt6-tools gnupg)
if "$home_manager"; then
  packages+=(fish)
  # Mason builds Neovim's language servers, formatters and debuggers with these.
  packages+=(rustup go python npm base-devel unzip)
  # Any installed Node.js serves; Pacman would otherwise ask to replace it.
  command -v node >/dev/null || packages+=(nodejs-lts-jod)
  # iwgetid gives the welcome its Wi-Fi name without asking NetworkManager.
  packages+=(wireless_tools)
  # Called by the Fish configuration: checkupdates and paccache (update, cleanup),
  # command suggestions, the SSH key prompt, finished-command notifications,
  # archive extraction, PDF previews and video previews.
  packages+=(pacman-contrib pkgfile ksshaskpass libnotify 7zip unrar poppler ffmpeg)
fi
# upgrade and full-upgrade-devel use paru, which Garuda's repositories carry
# and plain Arch's do not.
pacman -Si paru >/dev/null 2>&1 && packages+=(paru)
if "$apps"; then
  packages+=(libreoffice-fresh github-cli bottom yt-dlp plasma-systemmonitor flatpak)
  # Brave Origin comes from Chaotic-AUR, which plain Arch does not enable.
  pacman -Si brave-origin-bin >/dev/null 2>&1 && packages+=(brave-origin-bin)
fi
"$backup" && packages+=(restic)
"$boot_theme" && packages+=(apparmor)
# The theme is a Garuda package; restore-grub says so when a plain Arch lacks it.
[[ "$boot_loader" == grub && "$boot_look" == garuda ]] && "$boot_theme" && pacman -Si grub-theme-garuda-dr460nized >/dev/null 2>&1 && packages+=(grub-theme-garuda-dr460nized)
# The Boot Splash Screen page in System Settings; it needs Plymouth, which Garuda
# installs and plain Arch does not.
"$boot_splash" && packages+=(plymouth-kcm)
"$firewall" && packages+=(ufw gufw)
run sudo pacman -S --needed "${packages[@]}"
if "$home_manager"; then
  # Command suggestions read a per-user package file list, which starts out missing.
  pkgfile_cache=${XDG_CACHE_HOME:-$HOME/.cache}/pkgfile
  if [[ ! -d "$pkgfile_cache" ]]; then
    run mkdir -p "$pkgfile_cache"
    run pkgfile --cachedir "$pkgfile_cache" --update ||
      echo "The package file list was not downloaded; run pkgfile --cachedir $pkgfile_cache --update later." >&2
  fi
  # The rustup package ships no compiler until a toolchain is chosen.
  if "$dry_run"; then
    echo 'Would select the stable Rust toolchain if none is set.'
  elif ! rustup default >/dev/null 2>&1; then
    rustup default stable
  fi
fi

if "$apps"; then
  echo
  echo '==> Everyday apps'
  # A failed download here should not stop the rest of the setup.
  run sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo &&
    run sudo flatpak install -y flathub me.proton.Pass me.proton.Mail com.rustdesk.RustDesk io.missioncenter.MissionCenter ||
    echo 'Some Flathub apps were not installed; install them from Discover later.' >&2
  # Stacer is only in the AUR.
  if "$dry_run" || command -v paru >/dev/null; then
    run paru -S --needed stacer-bin || echo 'Stacer was not installed; run paru -S stacer-bin later.' >&2
  else
    echo 'Stacer needs an AUR helper such as paru; skipped.'
  fi
fi

if "$home_manager"; then
echo
echo '==> Nix'
load_nix() {
  local profile=/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  if [[ -r "$profile" ]]; then
    set +u
    # shellcheck disable=SC1090
    . "$profile"
    set -u
  fi
}
command -v nix >/dev/null || load_nix
if command -v nix >/dev/null; then
  echo 'Nix is already installed.'
elif "$dry_run"; then
  echo 'Would download and run the Determinate Nix installer.'
else
  [[ ! -d /nix ]] || die '/nix exists but nix is unavailable; repair that installation first.'
  echo 'Nix installs into /nix with build users and a system daemon.'
  read -r -p 'Download and run the Determinate Nix installer? [y/N] ' answer
  [[ "$answer" == [yY]* ]] || die 'Nix is required for the Home Manager configuration.'
  installer=$(mktemp)
  curl --fail --show-error --silent --location --proto '=https' --tlsv1.2 \
    https://install.determinate.systems/nix -o "$installer"
  sh "$installer" install || {
    rm -f -- "$installer"
    die 'the Nix installer did not finish.'
  }
  rm -f -- "$installer"
  load_nix
  command -v nix >/dev/null || die 'open a new terminal and run this script again to load Nix.'
fi

echo
echo '==> Home Manager'
attribute="$repo/home-manager#homeConfigurations.\"$USER\".activationPackage"
if "$dry_run"; then
  echo "Would build and activate $attribute"
else
  generation=$(nix --extra-experimental-features 'nix-command flakes' build --no-link --print-out-paths "$attribute")
  # Garuda ships its own Fish and terminal settings; keep them beside the new ones.
  HOME_MANAGER_BACKUP_EXT=before-dotfiles "$generation/activate"
fi
else
  echo
  echo '==> Nix and Home Manager'
  echo 'Skipped; run scripts/setup again to add them later.'
fi

echo
echo '==> Ghostty'
ghostty_config="$config_home/ghostty/config"
if [[ -e "$ghostty_config" || -L "$ghostty_config" ]]; then
  echo "Keeping the existing $ghostty_config."
elif ! "$home_manager"; then
  # The preset reads the palette theme and tab bar that Home Manager writes.
  echo 'The Ghostty preset needs the Home Manager theme files; the toolbox Ghostty entry installs it without them.'
elif "$dry_run"; then
  echo "Would copy the Ghostty preset to $ghostty_config."
else
  mkdir -p "$config_home/ghostty"
  # Ghostty reads both names, so an empty config.ghostty would conflict with the preset.
  if [[ -e "$config_home/ghostty/config.ghostty" ]]; then
    mv -- "$config_home/ghostty/config.ghostty" "$HOME/ghostty-config.ghostty.before-dotfiles"
  fi
  # A writable copy: Home Manager owns only the theme and tab bar beside it.
  install -m 644 "$repo/configs/ghostty/config" "$ghostty_config"
  echo "Copied the Ghostty preset to $ghostty_config."
fi
run kwriteconfig6 --file kdeglobals --group General --key TerminalApplication '/usr/bin/ghostty --gtk-single-instance=true'
run kwriteconfig6 --file kdeglobals --group General --key TerminalService com.mitchellh.ghostty.desktop

echo
echo '==> Login shell'
# Terminals open the login shell, and the Fish configuration is the one set up here.
if ! "$home_manager"; then
  echo 'Left alone: the Fish configuration comes with Home Manager.'
elif [[ "$login_shell" == */fish ]]; then
  echo 'Fish is already the login shell.'
elif run chsh -s /usr/bin/fish; then
  shell_changed=true
else
  echo 'The login shell was not changed; run chsh -s /usr/bin/fish yourself.' >&2
fi

if "$login_theme"; then
  echo
  echo '==> Login screen'
  # SilentSDDM is only in the AUR; restore-sddm puts the presets in sddm/ on top.
  if "$dry_run"; then
    run paru -S --needed sddm-silent-theme-git
    run env "DOTFILES_DIR=$repo" "$repo/home-manager/scripts/restore-sddm.sh"
  elif ! command -v paru >/dev/null; then
    echo 'SilentSDDM needs an AUR helper such as paru; skipped.'
  elif paru -S --needed sddm-silent-theme-git &&
    DOTFILES_DIR=$repo "$repo/home-manager/scripts/restore-sddm.sh"; then
    login_theme_installed=true
  else
    echo 'The login screen was not changed; run paru -S sddm-silent-theme-git and restore-sddm later.' >&2
  fi
  # The theme only appears when SDDM runs the login screen. Another display
  # manager stays installed (Garuda's desktop package depends on it) but is
  # disabled, and enable --force takes over its display-manager.service alias.
  if [[ "$display_manager" != sddm.service ]] && { "$dry_run" || "$login_theme_installed"; }; then
    if [[ -n "$display_manager" ]]; then
      run sudo systemctl disable "$display_manager"
    fi
    if run sudo systemctl enable --force sddm.service; then
      display_manager_switched=true
    else
      echo 'SDDM was not enabled; run sudo systemctl enable --force sddm.service later.' >&2
    fi
  fi
fi

if "$boot_theme"; then
  echo
  echo '==> Boot'
  # restore-grub installs grub/grub as /etc/default/grub, keeping the previous
  # file beside it, and regenerates the GRUB menu. restore-limine merges the
  # look in limine/ into limine.conf and the AppArmor parameter into
  # /etc/default/limine, then lets the entry tool regenerate the entries.
  if [[ "$boot_loader" == grub ]]; then
    restore_boot="$repo/home-manager/scripts/restore-grub.sh"
  else
    restore_boot="$repo/home-manager/scripts/restore-limine.sh"
  fi
  if "$dry_run"; then
    echo "Would write $boot_look to $config_home/dotfiles/boot-theme."
  else
    mkdir -p "$config_home/dotfiles"
    printf '%s\n' "$boot_look" > "$config_home/dotfiles/boot-theme"
  fi
  if run env "DOTFILES_DIR=$repo" "$restore_boot" "$boot_look"; then
    # The service loads the profiles; it starts working once the kernel boots with AppArmor.
    run sudo systemctl enable apparmor
    boot_theme_installed=true
  else
    echo "The boot settings were not changed; run $(basename "$restore_boot" .sh) later." >&2
  fi
fi

if "$boot_splash"; then
  echo
  echo '==> Boot splash'
  # restore-plymouth selects the theme and rebuilds the boot images with the
  # machine's own initramfs tool; the System Settings page cannot do that on Garuda.
  if run env "DOTFILES_DIR=$repo" "$repo/home-manager/scripts/restore-plymouth.sh"; then
    boot_splash_installed=true
  else
    echo 'The boot splash was not changed; run restore-plymouth later.' >&2
  fi
fi

if "$firewall"; then
  echo
  echo '==> Firewall'
  if command -v firewalld >/dev/null && systemctl is-enabled --quiet firewalld 2>/dev/null; then
    # Two firewalls editing the same rules give confusing results.
    run sudo systemctl disable --now firewalld
  fi
  run sudo ufw default deny incoming
  run sudo ufw default allow outgoing
  run sudo ufw logging low
  if pacman -Q kdeconnect-kde >/dev/null 2>&1; then
    # KDE Connect pairs over the local network; the rule stops at that network.
    lan=$(ip -4 -o addr show scope global 2>/dev/null | awk '{ print $4; exit }')
    if [[ -n "$lan" ]]; then
      lan=$(python3 -I -c 'import ipaddress, sys; print(ipaddress.ip_interface(sys.argv[1]).network)' "$lan")
      run sudo ufw allow from "$lan" to any port 1714:1764 proto tcp
      run sudo ufw allow from "$lan" to any port 1714:1764 proto udp
    fi
  fi
  run sudo ufw --force enable
  run sudo systemctl enable --now ufw
fi

if "$backup"; then
  echo
  echo '==> Restic repository'
  password_command=$(printf '%q ' kwallet-query -f "$wallet_folder" -r "$wallet_entry" "$wallet")
  if "$dry_run"; then
    if [[ -f "$restic_repository/config" ]]; then
      echo "Would reuse the repository at $restic_repository."
    else
      echo "Would store a new password in KWallet and create $restic_repository."
    fi
    [[ -e "$secrets_directory" ]] || echo "Would create $secrets_directory for encrypted recovery files."
  else
    if ! kwallet-query -f "$wallet_folder" -r "$wallet_entry" "$wallet" >/dev/null 2>&1; then
      if [[ -f "$restic_repository/config" ]]; then
        echo "Enter the existing password for $restic_repository."
      else
        echo 'Choose a password for the new backup repository. Keep a copy away from this drive:'
        echo 'without it the backups cannot be read.'
      fi
      while true; do
        read -r -s -p 'Repository password: ' password
        echo
        read -r -s -p 'Repeat it: ' repeated
        echo
        [[ -n "$password" && "$password" == "$repeated" ]] && break
        echo 'The passwords were empty or did not match.' >&2
      done
      # kwallet-query cannot create folders itself.
      handle=$(qdbus6 org.kde.kwalletd6 /modules/kwalletd6 org.kde.KWallet.open "$wallet" 0 dotfiles-setup)
      [[ "$handle" =~ ^[0-9]+$ ]] || die "could not open the $wallet wallet."
      qdbus6 org.kde.kwalletd6 /modules/kwalletd6 org.kde.KWallet.createFolder "$handle" "$wallet_folder" dotfiles-setup >/dev/null
      printf '%s' "$password" | kwallet-query -f "$wallet_folder" -w "$wallet_entry" "$wallet"
      [[ $(kwallet-query -f "$wallet_folder" -r "$wallet_entry" "$wallet") == "$password" ]] ||
        die "KWallet did not return the stored password; check $wallet / $wallet_folder / $wallet_entry in KWalletManager."
      unset password repeated
    else
      echo "Using the password already stored in KWallet ($wallet_folder / $wallet_entry)."
    fi
    if [[ -f "$restic_repository/config" ]]; then
      restic --repo "$restic_repository" --password-command "$password_command" snapshots --latest 1 >/dev/null ||
        die "the stored password does not open $restic_repository."
      echo "Reusing the repository at $restic_repository."
    else
      # udisks mounts some filesystems with a root-owned top directory. Create
      # only a new directory there: never chown something the drive supplied.
      if [[ ! -w "$backup_mount" ]]; then
        [[ ! -e "$restic_repository" && ! -L "$restic_repository" ]] ||
          die "$restic_repository already exists and is not a Restic repository; move it aside first."
        sudo mkdir -- "$restic_repository"
        sudo chown --no-dereference "$USER:$(id -gn)" -- "$restic_repository"
      fi
      restic --repo "$restic_repository" --password-command "$password_command" init
    fi
    # backup-everything keeps encrypted recovery files beside the repository,
    # and cannot create their directory on a root-owned drive either.
    if [[ ! -e "$secrets_directory" && ! -L "$secrets_directory" ]]; then
      if [[ -w "$backup_mount" ]]; then
        mkdir -m 700 -- "$secrets_directory"
      else
        sudo mkdir -m 700 -- "$secrets_directory"
        sudo chown --no-dereference "$USER:$(id -gn)" -- "$secrets_directory"
      fi
    elif [[ ! -d "$secrets_directory" || ! -w "$secrets_directory" ]]; then
      echo "Warning: $secrets_directory exists but you cannot write to it; backup-everything will fail there." >&2
    fi
  fi
fi

echo
echo 'Setup complete.'
if "$shell_changed"; then
  echo '  - Log out and back in: terminals open Fish only after a new login.'
else
  echo '  - Close every terminal window and open a new one.'
fi
if "$home_manager"; then
  echo '  - hm-rebuild applies later changes to this repository.'
else
  echo '  - For the terminal without Nix: Myfish, or the Dotfiles entries in the toolbox.'
fi
if "$login_theme_installed"; then
  echo '  - Preview the login screen before restarting: /usr/share/sddm/themes/silent/test.sh'
fi
if "$display_manager_switched"; then
  echo "  - Reboot to get the SDDM login screen; $display_manager stays installed but disabled."
fi
if "$boot_theme_installed"; then
  echo '  - Reboot to see the boot menu; aa-enabled then prints Yes.'
fi
if "$boot_splash_installed"; then
  echo '  - Reboot to see the boot splash. After picking another theme in System Settings,'
  echo '    run restore-plymouth --rebuild so it reaches the boot images.'
fi
if "$backup"; then
  echo '  - backup-personal runs your first backup; later ones start when the drive mounts.'
elif "$home_manager"; then
  echo '  - Run scripts/setup again with your backup drive attached to set up Restic.'
fi
