{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/png/garuda-bird.png",
        "width": 27
    },
    "display": {
        "separator": " ",
        "key": {
            "width": 18
        }
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": " DISTRO",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├ Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 Packages",
            "format": "{appimage} appimage, {flatpak-all} flatpak, {pacman} pacman{?pacman-branch} [{pacman-branch}]{?}",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 Nix",
            "format": "{nix-user} user, {nix-default} default",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "│ ├ OS Age",
            "keyColor": "yellow",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "shell",
            "key": "│ └ Shell",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼 Theme",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "│ ├󰀻 Icons",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "│ ├ Cursor",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": "│ ├ Font",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ └ Terminal",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 SYSTEM",
            "keyColor": "green"
        },
        {
            "type": "board",
            "key": "│ ├󰌢 Board",
            "keyColor": "green",
            "format": "{name}{?version} ({version}){?}"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├󰻑 GPU",
            "format": "{2}",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "│ ├󰍹 Display",
            "keyColor": "green",
            "compactType": "original-with-refresh-rate"
        },
        {
            "type": "memory",
            "key": "│ ├󰾆 Memory",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "│ ├󰓡 Swap",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│ ├󰅐 Uptime",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "│ ├󰩟 Local IP",
            "keyColor": "green",
            "text": "ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i==\"src\") {print $(i+1); exit}}' | head -n1"
        },
        {
            "type": "command",
            "key": "│ └󰖩 Wi-Fi",
            "keyColor": "green",
            "text": "iwgetid -r 2>/dev/null || nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1==\"yes\"{print $2; exit}'"
        },
        {
            "type": "sound",
            "key": " AUDIO",
            "format": "{name}",
            "keyColor": "magenta"
        },
        {
            "type": "player",
            "key": "│ ├󰥠 Player",
            "keyColor": "magenta"
        },
        {
            "type": "media",
            "key": "│ └󰝚 Media",
            "keyColor": "magenta"
        },
        "break",
        {
            "type": "custom",
            "format": "{#37}󰮯  {#38;2;255;89;89}󰊠 {#38;2;255;118;89}󰊠 {#38;2;255;148;89}󰊠 {#38;2;255;177;89}󰊠 {#38;2;255;206;89}󰊠 {#38;2;255;235;89}󰊠 {#38;2;245;255;89}󰊠 {#38;2;216;255;89}󰊠 {#38;2;187;255;89}󰊠 {#38;2;157;255;89}󰊠 {#38;2;128;255;89}󰊠 {#38;2;99;255;89}󰊠 {#38;2;89;255;109}󰊠 {#38;2;89;255;138}󰊠 {#38;2;89;255;167}󰊠 {#38;2;89;255;196}󰊠 {#38;2;89;255;226}󰊠 {#38;2;89;255;255}󰊠 {#38;2;89;226;255}󰊠 {#38;2;89;196;255}󰊠 {#38;2;89;167;255}󰊠 {#38;2;89;138;255}󰊠 {#38;2;89;109;255}󰊠 {#38;2;99;89;255}󰊠 {#38;2;128;89;255}󰊠 {#38;2;158;89;255}󰊠 {#38;2;187;89;255}󰊠 {#38;2;216;89;255}󰊠 {#38;2;245;89;255}󰊠 {#38;2;255;89;236}󰊠 {#38;2;255;89;206}󰊠 {#38;2;255;89;177}󰊠 {#38;2;255;89;148}󰊠 {#38;2;255;89;119}󰊠 {#0}"
        },
        "break"
    ]
}
