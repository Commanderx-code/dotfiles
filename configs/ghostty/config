# Commander
# Starting preset; the live ~/.config/ghostty/config is a writable copy.
# Reload: Ctrl+Shift+,   Appearance editor: spookiui

# The palette chosen with `rice`: Home Manager writes ~/.config/ghostty/themes/commander.
theme = commander
gtk-custom-css = ~/.config/ghostty/topbar.css
background-opacity = 0.94
background-blur = true
window-theme = dark

# The Nerd Font is already provided by Home Manager.
font-family = JetBrainsMono Nerd Font
font-size = 13
adjust-cell-height = 8%
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
# Full-screen apps such as Neovim paint to the window edge instead of leaving a frame.
window-padding-color = extend

# Default opening dimensions, in terminal cells.
window-width = 125
window-height = 35

# Integrated tabs and controls, including when maximized.
window-decoration = client
gtk-titlebar = true
gtk-titlebar-style = tabs
gtk-titlebar-hide-when-maximized = false
window-show-tab-bar = always
gtk-wide-tabs = false
gtk-toolbar-style = flat

# A calm cursor and a subtle distinction between active and inactive panes.
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
unfocused-split-opacity = 0.88

# Fish and Ghostty retain their normal directory/title integration.
shell-integration = detect
scrollback-limit = 25000000

# Keep native shortcuts; add a few conveniences.
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits
